#!/usr/bin/env bash
###############################################################################
# tw.nb-plugin
#
# Taskwarrior tasks and their nb notes as linked pairs:
#   nb tw note <id|uuid>          find or create the task's note
#   nb tw add  <description> [attrs…]   add a task and its note
#   nb tw link <selector> <id|uuid>     make an existing note a task's note
#   nb tw status <id|uuid>        mirror the task's status into its note (for hooks)
#   nb tw info <selector>         Taskwarrior info for the task(s) a note is about
#
# Recurring tasks get one note for the series (default) or one per occurrence (--each, a
# folder). The choice is the template's own nb: annotation (a note, or a folder ending in /),
# which every occurrence inherits.
#
# The link: the task carries `nb: <notebook>:<path>` (authoritative); the note carries
# `tw: <uuid>` in its frontmatter (a list when it serves several tasks). New notes are
# `<slug>-<uuid8>.note.md` with `type: task`, in `tasknotes:` unless told otherwise.
#
# Settings are taskrc entries (rc.*), e.g. in ~/.task/config/tw-nb.rc:
#   tw.notebook        = tasknotes  default notebook for new notes
#   tw.notebook.<proj> = cine   new notes for project <proj> (or a sub-project) go here
#   tw.folder_depth    = 1      folders in tasknotes: from the project: 0 none, 1 kitchen/,
#                               2 kitchen/reno/ (never deeper)
#
# Templates: <notebook>/.templates/task.md, {{field}} and {{field|default}} filled from the
# task (description, project, uuid, uuid8, id, due, scheduled, priority, tags, status, date).
#
# Every run takes nb-web's lock ($NB_DIR/.logs/nb-web-nb.lock, nb-web invariant 72) unless
# the caller already holds it and says so with NB_LOCK_HELD=1. `task` runs with
# rc.hooks=off for everything except `add` itself (so on-add hooks such as recurrence see
# a normal add). Notes are written directly and committed via `nb index reconcile
# --commit`, never `nb edit --overwrite --content` (it truncates frontmatter notes).
#
# Part of https://github.com/linuxcaffe/nb-plugins. Plan: tw-nb-interop.
###############################################################################

_subcommands add "tw"

_subcommands describe "tw" <<HEREDOC
$(_color_primary "Usage"):
  ${_ME} tw note <id|uuid> [--notebook <name>] [--series|--each] [--find]
               [--porcelain]
  ${_ME} tw add <description> [<attribute>...] [--notebook <name>] [--series|--each]
               [--porcelain]
  ${_ME} tw link <selector> <id|uuid> [--porcelain]
  ${_ME} tw status <id|uuid>
  ${_ME} tw info <selector>

$(_color_primary "Description"):
  Pair Taskwarrior tasks with nb notes. The task gets an 'nb: <notebook>:<path>'
  annotation; the note gets 'tw: <uuid>' in its frontmatter.

  note   Open the task's note: the one its nb: annotation names, else one whose
         frontmatter names the task, else a new one (type: task) in tasknotes: (or
         --notebook, or the project's tw.notebook.<project> setting).
         --find only looks: no new note, no annotation; exit 1 if none.
  add    Add a task (description first, then attributes such as project:x
         due:fri +tag) and create its note.
  link   Make an existing note this task's note. The note keeps its name, type
         and body; only its frontmatter gains tw:.
  status Write the task's status (tw_status, tw_end) into its note; for a
         series note, log the occurrence under '## Occurrences'. Reopening
         reverses it. Locked notes and notes serving several tasks are skipped.
  info   Show 'task info' for every task a note is about.

  Recurring tasks: one note for the series (default), or --each: a folder
  with one note per occurrence. The template's nb: annotation records the
  choice, and occurrences inherit it.

  --porcelain  print key: value lines (uuid, selector, path, created) for scripts.

$(_color_primary "Examples"):
  ${_ME} tw note 42
  ${_ME} tw add "Grout the backsplash" project:kitchen due:fri
  ${_ME} tw link cine:edl-definition.md 42
  ${_ME} tw info tasknotes:kitchen/grout-the-backsplash-1a2b3c4d.note.md
HEREDOC

# `nb info` was this plugin's only command in tw2nb; kept as an alias for a release.
_subcommands add "info"
_subcommands describe "info" <<HEREDOC
$(_color_primary "Usage"):
  ${_ME} info <selector>

$(_color_primary "Description"):
  Old name for '${_ME} tw info'.
HEREDOC

_info() {
  _tw info "$@"
}

_tw() {
  local _nb_bin=
  _nb_bin="$(command -v nb || printf "%s" "${0}")"
  NB_TW_BIN="${_nb_bin}" python3 -c "${_TW_NB_PY}" "$@"
}

read -r -d '' _TW_NB_PY <<'PYTHON' || true
import contextlib, fcntl, json, os, re, subprocess, sys
from datetime import date
from pathlib import Path

NB_DIR = Path(os.environ['NB_DIR'])
NB_BIN = os.environ.get('NB_TW_BIN') or 'nb'
UUID_RE = re.compile(r'^[0-9a-f]{8}(-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})?$')
ANSI_RE = re.compile(r'\x1b\[[0-9;?]*[A-Za-z]|\x1b\([A-Za-z0-9]')


def die(msg):
    print(f'nb tw: {msg}', file=sys.stderr)
    sys.exit(1)


@contextlib.contextmanager
def nb_lock():
    if os.environ.get('NB_LOCK_HELD') == '1':
        yield
        return
    path = NB_DIR / '.logs' / 'nb-web-nb.lock'
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, 'a') as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(f, fcntl.LOCK_UN)


# ── Taskwarrior ───────────────────────────────────────────────────────────────

def task(*args, hooks=False, check=True):
    argv = ['task'] + ([] if hooks else ['rc.hooks=off']) + ['rc.confirmation=off'] + list(args)
    r = subprocess.run(argv, capture_output=True, text=True, stdin=subprocess.DEVNULL,
                       env={**os.environ, 'NO_COLOR': '1'})
    if check and r.returncode != 0:
        die(f'task {" ".join(args)} failed: {r.stderr.strip() or r.stdout.strip()}')
    return r


_rc_cache = None


def rc(key, default=None):
    global _rc_cache
    if _rc_cache is None:
        _rc_cache = {}
        for line in task('rc.verbose=nothing', '_show', check=False).stdout.splitlines():
            k, sep, v = line.partition('=')
            if sep:
                _rc_cache[k.strip()] = v.strip()
    return _rc_cache.get(key, default)


def get_task(ref):
    """One task by numeric id or uuid (8 chars or full); dies if there isn't exactly one."""
    if ref.isdigit():
        filt = [ref]
    elif UUID_RE.match(ref.lower()):
        filt = [f'uuid:{ref}'] if len(ref) == 36 else [ref.lower()]
    else:
        die(f'not a task id or uuid: {ref}')
    r = task('rc.json.array=on', *filt, 'export', check=False)
    try:
        tasks = json.loads(r.stdout or '[]')
    except json.JSONDecodeError:
        tasks = []
    if not tasks:
        die(f'no task {ref}')
    if len(tasks) > 1:
        die(f'{ref} matches {len(tasks)} tasks')
    return tasks[0]


def annotate(uuid, text):
    task(uuid, 'annotate', '--', text)


# ── selectors and paths ───────────────────────────────────────────────────────

def is_notebook(name):
    return bool(name) and not name.startswith('.') and (NB_DIR / name / '.git').exists()


def selector_path(sel, bare_notebook):
    """Lexically confined path for a path selector, or None (no '..', no absolute paths).
    A selector without a notebook belongs to bare_notebook (None: no answer)."""
    nb, sep, rel = sel.partition(':')
    if not (sep and is_notebook(nb)):
        if not bare_notebook:
            return None
        nb, rel = bare_notebook, sel
    if not rel or rel.startswith('/') or '..' in Path(rel).parts:
        return None
    return NB_DIR / nb / rel


def nb_show_path(sel):
    """Ask nb, as `nb show <sel> --path` would answer on the command line (ids, titles,
    the current notebook for a bare selector)."""
    r = subprocess.run([NB_BIN, 'show', sel, '--path'], capture_output=True, text=True,
                       stdin=subprocess.DEVNULL)
    out = ANSI_RE.sub('', r.stdout).strip()
    if r.returncode == 0 and out and Path(out).is_file():
        return Path(out)
    return None


def resolve_selector(sel):
    """A command-line selector: a notebook path directly, else nb's own resolution."""
    p = selector_path(sel, None)
    if p and p.is_file():
        return p
    return nb_show_path(sel)


def resolve_annotation(sel):
    """An `nb:` annotation value: a bare path means tw: (the default notebook); anything
    that isn't a path (tw2nb's `tasks:45`) is resolved by nb."""
    p = selector_path(sel, default_notebook())
    if p and p.is_file():
        return p
    if ':' in sel and is_notebook(sel.partition(':')[0]):
        return nb_show_path(sel)
    return None


def selector_for(path):
    rel = path.relative_to(NB_DIR)
    return f'{rel.parts[0]}:{Path(*rel.parts[1:]).as_posix()}'


def default_notebook():
    return rc('tw.notebook') or 'tasknotes'


def notebook_for(t, explicit=None):
    if explicit:
        return explicit
    project = t.get('project', '')
    parts = project.split('.') if project else []
    for n in range(len(parts), 0, -1):
        mapped = rc('tw.notebook.' + '.'.join(parts[:n]))
        if mapped:
            return mapped
    return default_notebook()


def folder_for(t, nb):
    if nb != default_notebook() or not t.get('project'):
        return ''
    try:
        depth = max(0, min(2, int(rc('tw.folder_depth', '1'))))
    except ValueError:
        depth = 1
    parts = [slug(p) for p in t['project'].split('.')[:depth] if slug(p)]
    return ''.join(p + '/' for p in parts)


def slug(text):
    """annn's sanitize_for_filename: lowercase, non-alnum -> '-', squeezed, trimmed, 40 chars."""
    s = re.sub(r'[^a-z0-9]', '-', text.lower())
    s = re.sub(r'-+', '-', s).strip('-')
    return s[:40]


# ── frontmatter ───────────────────────────────────────────────────────────────

def split_frontmatter(text):
    """(frontmatter lines, body) or (None, text)."""
    if text.startswith('---\n'):
        end = text.find('\n---\n', 3)
        if end == -1 and text.endswith('\n---'):
            end = len(text) - 4
        if end != -1:
            return text[4:end].split('\n') if end > 4 else [], text[end + 5:]
    return None, text


def fm_uuids(lines):
    """uuids under the tw: key (scalar or list)."""
    out, in_tw = [], False
    for line in lines or []:
        if re.match(r'^tw:\s*$', line):
            in_tw = True
            continue
        m = re.match(r'^tw:\s*(\S+)', line)
        if m:
            out.append(m.group(1).strip('\'"'))
            in_tw = False
            continue
        if in_tw:
            m = re.match(r'^\s+-\s*(\S+)', line)
            if m:
                out.append(m.group(1).strip('\'"'))
                continue
            in_tw = False
    return out


def with_uuid(lines, uuid):
    """Frontmatter lines with uuid added under tw: (scalar -> list on the second task)."""
    have = fm_uuids(lines)
    if uuid in have:
        return lines
    out, i, done = [], 0, False
    while i < len(lines):
        line = lines[i]
        if not done and re.match(r'^tw:', line):
            j = i + 1
            while j < len(lines) and re.match(r'^\s+-', lines[j]):
                j += 1
            out.append('tw:')
            out += [f'  - {u}' for u in have + [uuid]]
            i, done = j, True
            continue
        out.append(line)
        i += 1
    if not done:
        out.append(f'tw: {uuid}')
    return out


def yaml_str(s):
    if s == '' or re.search(r'[:#\'"{}\[\],&*!|>%@`\\]', s) or s[0] in '-? ' or s[-1] == ' ':
        return json.dumps(s, ensure_ascii=False)
    return s


def contains_uuid(path, uuid):
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            head = f.read(4096)
    except OSError:
        return False
    lines, _ = split_frontmatter(head)
    return uuid in fm_uuids(lines)


def find_by_uuid(uuid):
    """A note whose frontmatter names this task, anywhere in any notebook (fallback only)."""
    notebooks = [default_notebook()] + sorted(
        p.name for p in NB_DIR.iterdir() if is_notebook(p.name) and p.name != default_notebook())
    for nb in notebooks:
        root = NB_DIR / nb
        if not root.is_dir():
            continue
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames if not d.startswith('.')]
            for name in filenames:
                if name.startswith('.') or not name.endswith('.md'):
                    continue
                p = Path(dirpath) / name
                # annn's <slug>-<uuid8>.note.md has no frontmatter until migrated
                if name.endswith(f'-{uuid[:8]}.note.md') or contains_uuid(p, uuid):
                    return p
    return None


# ── templates ─────────────────────────────────────────────────────────────────

def fields(t):
    return {
        'description': t.get('description', ''), 'project': t.get('project', ''),
        'uuid': t['uuid'], 'uuid8': t['uuid'][:8], 'id': str(t.get('id', '')),
        'due': t.get('due', ''), 'scheduled': t.get('scheduled', ''),
        'priority': t.get('priority', ''), 'tags': ' '.join(t.get('tags', [])),
        'status': t.get('status', ''), 'date': date.today().isoformat(),
    }


def fill(text, values):
    def sub(m):
        name, _, default = m.group(1).partition('|')
        return values.get(name.strip()) or default
    return re.sub(r'\{\{\s*([a-z0-9_]+(?:\|[^}]*)?)\s*\}\}', sub, text)


def note_body(t, nb):
    tpl = NB_DIR / nb / '.templates' / 'task.md'
    if tpl.is_file():
        body = fill(tpl.read_text(), fields(t))
        _, body = split_frontmatter(body)
        return body if body.endswith('\n') else body + '\n'
    return f'# {t.get("description", "")}\n'


# ── locks (nb-web invariant 76: the same rule as _lock_reason) ────────────────

def lock_reason(path):
    """Why path (a note, or a folder to write into) is locked, or None: a .nb-lock in its
    folder chain up to the notebook root, or the note's own `lock: yes|on|true|1`."""
    p = path if path.is_dir() or not path.exists() else path.parent
    while not p.exists() and p != p.parent:
        p = p.parent
    try:
        root = NB_DIR / p.relative_to(NB_DIR).parts[0]
    except (ValueError, IndexError):
        return None
    cur = p
    while True:
        if (cur / '.nb-lock').exists():
            return f'{cur.name} is locked'
        if cur == root or cur == cur.parent:
            break
        cur = cur.parent
    if path.is_file():
        lines, _ = split_frontmatter(path.read_text(errors='replace'))
        for line in lines or []:
            m = re.match(r'^lock:\s*(.*)$', line)
            if m and re.match(r'^(yes|on|true|1)$', m.group(1).strip().strip('\'"'), re.I):
                return 'this note is locked (lock: yes)'
    return None


def refuse_if_locked(path):
    why = lock_reason(path)
    if why:
        die(f'{selector_for(path) if path.exists() else path}: {why} -- unlock it first')


# ── writing ───────────────────────────────────────────────────────────────────

def commit(path):
    """Index a note's folder (or a new folder itself, and any new ancestors) and commit,
    nb's own way; then commit anything nb left (it may not, depending on its version)."""
    folder = path if path.is_dir() else path.parent
    subprocess.run([NB_BIN, 'index', 'reconcile', str(folder), '--ancestors', '--commit'],
                   capture_output=True, text=True, stdin=subprocess.DEVNULL)
    nb_root = NB_DIR / path.relative_to(NB_DIR).parts[0]
    status = subprocess.run(['git', '-C', str(nb_root), 'status', '--porcelain'],
                            capture_output=True, text=True).stdout
    if status.strip():
        subprocess.run(['git', '-C', str(nb_root), 'add', '-A'], capture_output=True)
        subprocess.run(['git', '-C', str(nb_root), 'commit', '-q', '-m',
                        f'[nb tw] {path.relative_to(nb_root)}'], capture_output=True)


def write_note(path, lines, body):
    path.write_text('---\n' + '\n'.join(lines) + '\n---\n' + body)
    commit(path)


def note_filename(t):
    return f'{slug(t.get("description") or "task") or "task"}-{t["uuid"][:8]}'


def create_note(t, nb, folder=None, extra=()):
    """A new tasknote: in `folder` (a Path) if given, else nb's root or project folder."""
    if folder is None:
        if not is_notebook(nb):
            die(f'no notebook {nb}')
        folder = NB_DIR / nb / folder_for(t, nb)
    path = folder / f'{note_filename(t)}.note.md'
    refuse_if_locked(path)
    folder.mkdir(parents=True, exist_ok=True)
    nb = path.relative_to(NB_DIR).parts[0]
    fm = ['type: task', f'tw: {t["uuid"]}', *extra, f'tw_status: {effective_status(t)}',
          f'title: {yaml_str(t.get("description", ""))}']
    write_note(path, fm, note_body(t, nb))
    return path


def create_series_folder(tpl, nb):
    if not is_notebook(nb):
        die(f'no notebook {nb}')
    folder = NB_DIR / nb / folder_for(tpl, nb) / note_filename(tpl)
    refuse_if_locked(folder)
    folder.mkdir(parents=True, exist_ok=True)
    commit(folder)
    return folder


def set_keys(lines, updates, removes=()):
    """Frontmatter lines with scalar keys set (in place, else appended) and others removed."""
    out, seen = [], set()
    for line in lines:
        m = re.match(r'^([A-Za-z0-9_-]+):', line)
        key = m.group(1) if m else None
        if key in removes:
            continue
        if key in updates:
            out.append(f'{key}: {updates[key]}')
            seen.add(key)
            continue
        out.append(line)
    out += [f'{k}: {v}' for k, v in updates.items() if k not in seen]
    return out


def note_annotations(t):
    return [a['description'][4:].strip() for a in t.get('annotations', [])
            if a.get('description', '').startswith('nb: ')]


def annotation_target(sel):
    """What an nb: annotation points at: a folder (trailing '/'), a note, or None."""
    if sel.endswith('/'):
        d = selector_path(sel.rstrip('/'), default_notebook())
        return d if d and d.is_dir() else None
    return resolve_annotation(sel)


def link_to(uuid, target):
    """Annotate the task with nb: <target> unless one of its annotations already points there."""
    t = get_task(uuid)
    if any(annotation_target(a) == target for a in note_annotations(t)):
        return
    sel = selector_for(target) + ('/' if target.is_dir() else '')
    annotate(uuid, f'nb: {sel}')


def find_note(t):
    """(path, from_annotation) for the task's existing note, or (None, False). A note that
    names the task in its own tw: frontmatter beats one that doesn't (tw2nb's archive link
    `nb: tasks:N` may come first)."""
    files = [p for p in (annotation_target(a) for a in note_annotations(t)) if p and p.is_file()]
    for p in files:
        if contains_uuid(p, t['uuid']):
            return p, True
    if files:
        return files[0], True
    p = find_by_uuid(t['uuid'])
    return (p, False) if p else (None, False)


def report(porcelain, t, path, created):
    sel = selector_for(path) + ('/' if path.is_dir() else '')
    if porcelain:
        print(f'uuid: {t["uuid"]}\nselector: {sel}\npath: {path}\ncreated: {"yes" if created else "no"}')
    else:
        print(f'{"Created" if created else "Note"}: {sel}')


# ── recurring ─────────────────────────────────────────────────────────────────

def template_uuid(t):
    """The recurrence template's uuid: an occurrence's parent: (native) or rtemplate
    (recurrence-overhaul), the task itself when it is a template, else None."""
    tp = t.get('parent') or t.get('rtemplate')
    if tp:
        return tp
    if t.get('status') == 'recurring' or t.get('recur') or t.get('r'):
        return t['uuid']
    return None


def occurrences(tpl_uuid):
    r = task('rc.json.array=on', '(', '+PENDING', 'or', '+WAITING', ')', 'export', check=False)
    try:
        tasks = json.loads(r.stdout or '[]')
    except json.JSONDecodeError:
        return []
    return [x for x in tasks
            if x['uuid'] != tpl_uuid and (x.get('parent') or x.get('rtemplate')) == tpl_uuid]


def recur_mode(t, tpl_uuid):
    """('each', folder) | ('series', note) | (None, None), from t's nb: annotations."""
    targets = [annotation_target(a) for a in note_annotations(t)]
    for p in targets:
        if p and p.is_dir():
            return 'each', p
    for p in targets:
        if p and p.is_file() and tpl_uuid in fm_uuids(
                split_frontmatter(p.read_text(errors='replace'))[0]):
            return 'series', p
    return None, None


def find_series_folder(tpl_uuid):
    root = NB_DIR / default_notebook()
    for dirpath, dirnames, _ in os.walk(root):
        dirnames[:] = [d for d in dirnames if not d.startswith('.')]
        for d in dirnames:
            if d.endswith(f'-{tpl_uuid[:8]}'):
                return Path(dirpath) / d
    return None


def series_of(t, tpl_uuid, tpl=None):
    """(mode, target) for a recurring task: the template's choice, else the occurrence's
    inherited link, else one found on disk."""
    tpl = tpl or (t if t['uuid'] == tpl_uuid else get_task(tpl_uuid))
    mode, target = recur_mode(tpl, tpl_uuid)
    if not mode:
        mode, target = recur_mode(t, tpl_uuid)
    if not mode:
        found = find_series_folder(tpl_uuid) or find_by_uuid(tpl_uuid)
        if found:
            mode, target = ('each' if found.is_dir() else 'series'), found
    return mode, target


def occurrence_note(t, folder):
    """An each-mode occurrence's own note, if it has one."""
    for a in note_annotations(t):
        p = annotation_target(a)
        if p and p.is_file():
            return p
    for p in folder.glob('*.note.md'):
        if p.name.endswith(f'-{t["uuid"][:8]}.note.md') or contains_uuid(p, t['uuid']):
            return p
    return None


def ensure_recurring(t, tpl_uuid, notebook, each):
    tpl = t if t['uuid'] == tpl_uuid else get_task(tpl_uuid)
    mode, target = series_of(t, tpl_uuid, tpl)
    created = False
    if not mode:
        nb = notebook_for(tpl, notebook)
        if each:
            mode, target = 'each', create_series_folder(tpl, nb)
        else:
            mode, target = 'series', create_note(tpl, nb, extra=['tw_recur: series'])
            created = True
    for u in [tpl_uuid] + [o['uuid'] for o in occurrences(tpl_uuid)]:
        link_to(u, target)
    if mode == 'series' or t['uuid'] == tpl_uuid:
        return target, created
    own = occurrence_note(t, target)
    if own is None:
        own = create_note(t, None, folder=target, extra=[f'tw_template: {tpl_uuid}'])
        created = True
    link_to(t['uuid'], own)
    return own, created


def ensure_note(t, notebook=None, each=False):
    tpl_uuid = template_uuid(t)
    if tpl_uuid:
        return ensure_recurring(t, tpl_uuid, notebook, each)
    path, from_ann = find_note(t)
    created = False
    if path is None:
        path = create_note(t, notebook_for(t, notebook))
        created = True
    if not from_ann:
        annotate(t['uuid'], f'nb: {selector_for(path)}')
    return path, created


# ── status mirroring ─────────────────────────────────────────────────────────

def end_date(t):
    from datetime import datetime, timezone
    end = t.get('end')
    if not end:
        return date.today().isoformat()
    utc = datetime.strptime(end, '%Y%m%dT%H%M%SZ').replace(tzinfo=timezone.utc)
    return utc.astimezone().date().isoformat()          # local, like nb-web's isoDate


def effective_status(t):
    """Taskwarrior 2.6 stores a waiting task as pending with a future wait: (+WAITING is
    virtual); the note says waiting."""
    from datetime import datetime, timezone
    status = t.get('status', 'pending')
    if status == 'pending' and t.get('wait'):
        wait = datetime.strptime(t['wait'], '%Y%m%dT%H%M%SZ').replace(tzinfo=timezone.utc)
        if wait > datetime.now(timezone.utc):
            return 'waiting'
    return status


def mirror(path, t):
    """Write t's status into the note, if the note is this task's alone and not locked."""
    lines, body = split_frontmatter(path.read_text(errors='replace'))
    if lines is None or fm_uuids(lines) != [t['uuid']]:
        return                    # annn's plain notes, notes serving several tasks
    why = lock_reason(path)
    if why:
        print(f'skipped {selector_for(path)}: {why}')
        return
    status = effective_status(t)
    if status in ('completed', 'deleted'):
        new = set_keys(lines, {'tw_status': status, 'tw_end': end_date(t)})
    else:
        new = set_keys(lines, {'tw_status': status}, removes=('tw_end',))
    if new != lines:
        write_note(path, new, body)


def log_occurrence(path, occ):
    """A series note's `## Occurrences` line for a finished occurrence (removed on reopen)."""
    why = lock_reason(path)
    if why:
        print(f'skipped {selector_for(path)}: {why}')
        return
    text = path.read_text(errors='replace')
    tag = f'({occ["uuid"][:8]})'
    kept = [ln for ln in text.split('\n') if not (ln.startswith('- ') and ln.endswith(tag))]
    status = occ.get('status')
    line = {'completed': f'- {end_date(occ)} ✓ done {tag}',
            'deleted': f'- {end_date(occ)} ✗ deleted {tag}'}.get(status)
    if line:
        if '## Occurrences' not in kept:
            while kept and kept[-1] == '':
                kept.pop()
            kept += ['', '## Occurrences', '']
        i = kept.index('## Occurrences') + 1
        while i < len(kept) and not kept[i].startswith('#'):
            i += 1
        while i > 0 and kept[i - 1] == '':
            i -= 1
        kept.insert(i, line)
    new = '\n'.join(kept)
    if not new.endswith('\n'):
        new += '\n'
    if new != text:
        path.write_text(new)
        commit(path)


# ── commands ──────────────────────────────────────────────────────────────────

def take_option(args, name):
    if name in args:
        i = args.index(name)
        if i + 1 >= len(args):
            die(f'{name} needs a value')
        value = args[i + 1]
        del args[i:i + 2]
        return value
    return None


def take_flag(args, name):
    if name in args:
        args.remove(name)
        return True
    return False


def lookup_note(t):
    """The task's existing note (or series note / folder), never creating or annotating."""
    tpl_uuid = template_uuid(t)
    if tpl_uuid:
        mode, target = series_of(t, tpl_uuid)
        if mode == 'each' and t['uuid'] != tpl_uuid:
            return occurrence_note(t, target)
        return target
    return find_note(t)[0]


def cmd_note(args, porcelain):
    notebook = take_option(args, '--notebook')
    each = take_flag(args, '--each')
    find_only = take_flag(args, '--find')
    take_flag(args, '--series')                 # the default
    if len(args) != 1:
        die('usage: nb tw note <id|uuid> [--notebook <name>] [--series|--each] [--find]')
    t = get_task(args[0])
    if find_only:
        path = lookup_note(t)
        if path is None:
            print(f'nb tw: no note for task {args[0]}', file=sys.stderr)
            sys.exit(1)
        report(porcelain, t, path, False)
        return
    path, created = ensure_note(t, notebook, each)
    report(porcelain, t, path, created)


def cmd_add(args, porcelain):
    notebook = take_option(args, '--notebook')
    each = take_flag(args, '--each')
    take_flag(args, '--series')
    if not args:
        die('usage: nb tw add <description> [<attribute>...] [--series|--each]')
    desc, attrs = args[0], args[1:]
    for a in attrs:   # attributes only: name:value, +tag, -tag (no words that could be commands)
        # never an rc override (rc.name:value), never a command word (nb-web invariant 82)
        if a.lower().startswith('rc.') or \
                not re.match(r'^([a-z][a-z0-9_.]*:\S*|[+-][A-Za-z0-9_]+)$', a):
            die(f'not an attribute: {a}' + (' (for a tag Taskwarrior can\'t take as +tag, use tags:a,b)' if a[:1] in '+-' else ''))
    r = task('rc.verbose=new-uuid', 'add', *attrs, '--', desc, hooks=True)
    m = re.search(r'Created task ([0-9a-f-]{36})', r.stdout)
    if not m:
        die(f'task add printed no uuid: {r.stdout.strip()}')
    t = get_task(m.group(1))
    path, created = ensure_note(t, notebook, each)
    report(porcelain, t, path, created)


def cmd_link(args, porcelain):
    if len(args) != 2:
        die('usage: nb tw link <selector> <id|uuid>')
    path = resolve_selector(args[0])
    if not path:
        die(f'no note {args[0]}')
    t = get_task(args[1])
    lines, body = split_frontmatter(path.read_text())
    new_lines = with_uuid(lines or [], t['uuid'])
    if new_lines != lines:
        refuse_if_locked(path)
        write_note(path, new_lines, body)
    link_to(t['uuid'], path)
    report(porcelain, t, path, False)


def cmd_status(args, porcelain):
    """Mirror a task's status into its note(s). Quiet and annotation-only (no disk scan):
    hooks call it on every status change."""
    if len(args) != 1:
        die('usage: nb tw status <id|uuid>')
    t = get_task(args[0])
    tpl_uuid = template_uuid(t)
    if tpl_uuid and tpl_uuid != t['uuid']:      # an occurrence
        targets = [annotation_target(a) for a in note_annotations(t)]
        folder = next((p for p in targets if p and p.is_dir()), None)
        if folder:
            own = next((p for p in targets if p and p.is_file()), None)
            if own:
                mirror(own, t)
            return
        series = next((p for p in targets if p and p.is_file() and tpl_uuid in fm_uuids(
            split_frontmatter(p.read_text(errors='replace'))[0])), None)
        if series:
            log_occurrence(series, t)
            return
    for a in note_annotations(t):
        p = annotation_target(a)
        if p and p.is_file():
            mirror(p, t)


def cmd_info(args, porcelain):
    if len(args) != 1:
        die('usage: nb tw info <selector>')
    path = resolve_selector(args[0])
    if not path:
        die(f'no note {args[0]}')
    text = path.read_text(errors='replace')
    lines, body = split_frontmatter(text)
    uuids = fm_uuids(lines)
    for u in re.findall(r'`([0-9a-f]{8})`', body):   # tw2nb's journal/archive format
        if not any(x.startswith(u) for x in uuids):
            uuids.append(u)
    if not uuids:
        die(f'no Taskwarrior uuids in {args[0]}')
    for i, u in enumerate(uuids):
        if len(uuids) > 1:
            print('─' * 48)
        r = task('rc.verbose=nothing', f'uuid:{u}' if len(u) == 36 else u, 'information', check=False)
        print(r.stdout.rstrip() if r.returncode == 0 and r.stdout.strip() else f'not found: {u}')
    if len(uuids) > 1:
        print('─' * 48)


def main():
    args = sys.argv[1:]
    porcelain = '--porcelain' in args
    args = [a for a in args if a != '--porcelain']
    if not args:
        die('usage: nb tw (note|add|link|status|info) …   (nb help tw)')
    cmd, rest = args[0], args[1:]
    handler = {'note': cmd_note, 'add': cmd_add, 'link': cmd_link, 'info': cmd_info,
               'status': cmd_status}.get(cmd)
    if not handler:
        die(f'unknown command {cmd} (note, add, link, status, info)')
    with nb_lock():
        handler(rest, porcelain)


main()
PYTHON
